{
  "name": "telemetry-monitor",
  "author": "Assaf Itzikson",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "yarn typecheck && yarn build:frontend && tsc -p tsconfig.build.json",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json",
    "test": "yarn build:frontend && vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9",
    "@fastify/static": "^7",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5",
    "vitest": "^2.1.0"
  }
}
